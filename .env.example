# Скопируйте в .env рядом с docker-compose.yml, чтобы переопределить значения по умолчанию.
# docker compose автоматически подхватывает .env.

DP_API_PORT=8080
DP_SYNC_PORT=8090
IMITATOR_1C_PORT=8081
IMITATOR_BITRIX_PORT=8082
REAL_1C_PORT=8083
REAL_BITRIX_PORT=8084

DP_API_KEY=dev-key

POSTGRES_PORT=5432
RABBIT_MQ_PORT=5672
RABBIT_UI_PORT=15672

# Режим интеграционных адаптеров при старте: auto | real | stub.
# auto — реальная система при доступности, иначе наш сервис-заместитель (imitator-*).
ONEC_MODE=auto
BITRIX_MODE=auto

# Адреса «реальных» систем (поднимаются через docker-compose.real.yml,
# либо укажите адреса настоящих контуров 1С/Битрикс24).
ONEC_REAL_URL=http://real-1c:8080
BITRIX_REAL_URL=http://real-bitrix:8080
