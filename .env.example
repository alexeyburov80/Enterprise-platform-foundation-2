# ==== Dp.Platform MVP: конфигурация развертывания (скопируйте в .env) ====

# Токен доступа к платформе через шлюз (MVP: offline-заглушка OIDC).
DP_API_TOKEN=dp-dev-token

# Режим адаптеров интеграции:
#   auto — реальная система; при её недоступности замещается имитатором
#   real — только реальная система (быстрый отказ, если её нет)
#   stub — только имитатор
ADAPTER_1C_MODE=auto
ADAPTER_BITRIX_MODE=auto

# Адреса реальных систем (если есть у клиента).
# Пример: ADAPTER_1C_PRIMARY_URL=http://1c-host:8080/erp/odata
ADAPTER_1C_PRIMARY_URL=http://1c-real:8080
ADAPTER_BITRIX_PRIMARY_URL=http://bitrix-real:8080

# Ключ вебхука имитатора Битрикс (требуется в путях /rest/{key}/...).
STUB_BITRIX_KEY=demo
