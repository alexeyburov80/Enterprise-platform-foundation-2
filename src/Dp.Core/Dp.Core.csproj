<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Библиотека ядра Data Platform: SD, DDL, StoreService, Query DSL, Outbox,
       адаптеры интеграции. Sdk.Web выбран, чтобы шарить типы ASP.NET
       (ILogger, IConfiguration, BackgroundService) с хостами Dp.Api/Dp.Sync. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dp.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.7" />
    <PackageReference Include="RabbitMQ.Client" Version="6.8.1" />
    <PackageReference Include="YamlDotNet" Version="16.2.0" />
  </ItemGroup>

</Project>
