<Project Sdk="Microsoft.NET.Sdk">
  <!-- Однократный консольный прогон: применяет forward-only миграции и пишет журнал.
       Консольное приложение не тянет ASP.NET shared framework, поэтому зависимости
       Npgsql вендорятся явно (иначе не резолвятся в runtime в контейнере aspnet). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Dp.Platform.Migrator</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Npgsql">
      <HintPath>..\..\lib\Npgsql.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>..\..\lib\Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Extensions.DependencyInjection.Abstractions">
      <HintPath>..\..\lib\Microsoft.Extensions.DependencyInjection.Abstractions.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
